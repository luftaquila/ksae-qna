# Qdrant Configuration
QDRANT_URL=https://your-qdrant-server:443
QDRANT_API_KEY=your_qdrant_api_key

# Google Gemini API Key (Required for chatbot)
GOOGLE_API_KEY=your_gemini_api_key

# Anthropic API Key (Optional — required for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT Secret (auto-generated on first run if not set)
# JWT_SECRET=your_jwt_secret

# Admin emails (comma-separated, these users can access /admin)
ADMIN_EMAILS=admin@example.com

# HTTPS mode (set to true when deployed behind HTTPS reverse proxy)
# Enables secure cookies for session and auth
# HTTPS_ONLY=true

# NicePay (결제창 서버승인).  clientId 는 브라우저로 나가는 공개값이고
# secretKey 는 서버 전용이다 — 저장소에 커밋하지 말 것.
NICEPAY_CLIENT_ID=R2_your_client_id
NICEPAY_SECRET_KEY=your_secret_key
# 운영 https://api.nicepay.co.kr / 샌드박스 https://sandbox-api.nicepay.co.kr
NICEPAY_API_BASE=https://api.nicepay.co.kr

# 결제창 returnUrl 을 만들 때 쓰는 절대 주소.  없으면 요청 기준으로 유추한다.
SITE_URL=https://ksae-qna.luftaquila.io

# Build/version identifier exposed by /api/health (normally injected by Docker build)
# APP_VERSION=development
